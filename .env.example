VITE_API_BASE_URL=http://localhost:3000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Sentry (monitoreo de errores, ENG-83)
# TODAS opcionales. Sin VITE_SENTRY_DSN el SDK queda inactivo y no envía nada,
# que es lo que se espera en local y en CI.
#
# Ojo: las VITE_* son de BUILD, no de runtime — Vite las hornea en el bundle al
# compilar. Como el build de producción lo hace Render, se configuran allá y
# cambiarlas exige recompilar.
#
# El DSN no es un secreto: es público por diseño y viaja en el bundle. El token
# de subida de source maps (SENTRY_AUTH_TOKEN) SÍ lo es, no lleva prefijo VITE_
# para que nunca llegue al cliente, y solo se define en el entorno de build.
VITE_SENTRY_DSN=
# development | staging | production. Si no se declara, cae al modo de Vite.
VITE_SENTRY_ENVIRONMENT=
# Versión desplegada. Debe coincidir con el release con el que se suben los
# source maps, o los stack traces no se resuelven.
VITE_SENTRY_RELEASE=
